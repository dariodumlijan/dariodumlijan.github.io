---
import { getImage } from "astro:assets";
import { frontmatter as profile } from "@content/shared/profile.md";
import { frontmatter as skills } from "@content/shared/skills.md";
import profileImage from "@images/profile.webp";
import "@styles/reset.css";
import "@styles/main.scss";

type Props = {
  pagePath?: string;
  pageTitle?: string;
  pageDescription?: string;
};

const { pagePath, pageTitle, pageDescription } = Astro.props;

const url = pagePath ? profile.baseUrl + pagePath : profile.baseUrl;
const title = pageTitle ? `${profile.name} | ${pageTitle}` : profile.name;
const description = pageDescription || profile.description;

const languages = skills.skills.map(
  (skill: { language: string }) => skill.language,
);
const keywords = [
  profile.name,
  profile.alternateName,
  ...profile.keywords,
  ...languages,
].join(", ");
const year = new Date().getFullYear();

type Social = { icon: string; label: string; value: string };
const sameAs = profile.socials.map((social: Social) => social.value);

const ogImage = await getImage({
  src: profileImage,
  width: 1200,
  height: 1200,
  format: "jpg",
});
const ogImageUrl = profile.baseUrl + ogImage.src;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="all" />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" sizes="any" type="image/svg+xml" href="/favicon.svg" />

    {/* HTML Meta Tags */}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={profile.name} />
    <meta name="copyright" content={year.toString()} />
    <meta name="generator" content={Astro.generator} />

    {/* Open Graph Meta Tags */}
    <meta property="og:title" content={title} />
    <meta property="og:renderedTitle" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:keywords" content={keywords} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={`${profile.name} - profile photo`} />

    {/* Twitter Meta Tags */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:domain" content={url.replace("https://", "")} />

    {/* Schema.org Tag */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: profile.name,
        alternateName: profile.alternateName,
        jobTitle: profile.title,
        description: description,
        image: ogImageUrl,
        url: profile.baseUrl,
        mainEntityOfPage: url,
        sameAs: sameAs,
      })}
    />
  </head>
  <body>
    <slot />
    <footer>
      {profile.baseUrl.replace("https://", "")} &copy;&NonBreakingSpace;<span
        id="footer-year">{year}</span
      >
    </footer>
    <script is:inline>
      const actualYear = new Date().getFullYear();
      document.getElementById("footer-year").innerText = actualYear;
      document
        .querySelector('meta[name="copyright"]')
        .setAttribute("content", actualYear);
    </script>
  </body>
</html>
